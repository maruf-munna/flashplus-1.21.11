{
	"schemaVersion": 1,
	"id": "flashplus",
	"version": "${version}",
	"name": "flashplus",
	"description": "This mod fuck everyone up",
	"authors": [
		"RedLife",
		"Maruf"
	],
	"license": "MIT",
	"icon": "assets/flashplus/icon.png",
	"environment": "*",
