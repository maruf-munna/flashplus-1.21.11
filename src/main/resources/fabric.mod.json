			"config": "flashplus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": ">=26.1",
		"java": ">=21",
		"fabric-api": "*",
		"flashback": ">=${flashback_version}"
	}
}